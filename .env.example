# --- Gemma 4 (the only generative model the app uses at runtime) ---
# Hosted through the Gemini API. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemma 4 model ID. Documented options: gemma-4-26b-a4b-it (default), gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- Live resource search (optional) ---
# https://app.tavily.com  — without it the app uses the labeled curated catalog.
TAVILY_API_KEY=

# --- Supabase (Auth + Postgres) ---
# Project Settings -> API. Use the project URL only: https://<project-ref>.supabase.co
# (not the .../rest/v1/ endpoint). Without these the app runs on a labeled local demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely to call the sf_commit RPC and read private answer keys,
# after the signed-in user has been verified. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Set to 1 to force deterministic fixture content even when GEMINI_API_KEY is set.
SKILLFORGE_FIXTURE_MODE=

# --- Local demo store only (used when Supabase is not configured) ---
# Signs the local session cookie. If empty, a random secret is generated in .data/.
LOCAL_SESSION_SECRET=
# Where the local JSON store lives (default: ./.data).
SKILLFORGE_DATA_DIR=
# Set to 1 to allow the local session cookie over plain http in production builds.
SKILLFORGE_INSECURE_COOKIE=

# --- npm run seed ---
# Demo learner created by the seed script. SEED_PASSWORD is required in Supabase mode.
SEED_EMAIL=
SEED_PASSWORD=
